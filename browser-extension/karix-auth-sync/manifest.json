{
  "manifest_version": 3,
  "name": "Karix, MoEngage & VILPOWER Auth Sync",
  "version": "2.0.6",
  "description": "Sync manually authenticated Karix, MoEngage and Tata VILPOWER sessions to their individually paired account integrations.",
  "minimum_chrome_version": "124",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "https://whitelisting-agent.onrender.com/*",
    "https://rcsgui.karix.solutions/*",
    "https://rcmui.instaalerts.zone/*",
    "https://*.moengage.com/*",
    "https://www.vilpower.in/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Auth Sync"},
  "content_scripts": [
    {
      "matches": ["https://whitelisting-agent.onrender.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
