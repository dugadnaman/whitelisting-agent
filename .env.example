# =============================================================================
# Karix WhatsApp Template Submission — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# =============================================================================


# ---------------------------------------------------------------------------
# SESSION-BASED AUTH (portal API — what currently works)
# ---------------------------------------------------------------------------
# Bajaj: prefer Settings → Bajaj → WhatsApp → Download extension ZIP / Connect.
# Log in with your mobile OTP and open the template list; Chrome syncs headers.
# Legacy manual env values below remain a fallback until a session is synced.
# Other tenants still require their own separately scoped credentials.
#
# The portal API base URL is: https://rcsgui.karix.solutions/v1.0/templates
# (note: NO /api prefix, plural "templates")

KARIX_BEARER_TOKEN=
KARIX_SESSION=
KARIX_USER=

# Exact custom Settings origins allowed for configured extension downloads/pairing.
# Default production and localhost:3000 origins need no additional configuration.
# HTTPS required except localhost/127.0.0.1. Keep JWT_SECRET stable for encryption.
KARIX_EXTENSION_AGENT_ORIGINS=


# ---------------------------------------------------------------------------
# OFFICIAL STATIC CREDENTIALS (provided by Bajaj)
# ---------------------------------------------------------------------------
# These are the API keys Bajaj officially shared. They may correspond to a
# different API surface than the portal endpoints above.
#
# IMPORTANT: WABA_AUTH_TOKEN returned "Unauthorised User" when used against
# the portal API (https://rcsgui.karix.solutions/v1.0/templates/...).
# It may work against the official WABA_TEMPLATE_ENDPOINT instead — TBD.

# -- WhatsApp (WABA) --
WABA_TEMPLATE_ENDPOINT=https://rcsgui.karix.solutions/api/v1.0/template
WABA_AUTH_TOKEN=
WABA_ID=286109054585247
WABA_API_URL=https://rcmapi.instaalerts.zone/services/rcm/scheduleMessage
WABA_SENDER=

# -- General Karix / RCS (out of scope for now) --
KARIX_AUTH_TOKEN=
KARIX_SENDER_ID=
RCS_API_URL=https://rcmapi.instaalerts.zone/services/rcm/scheduleMessage
RCS_API_KEY=
RCS_SENDER=

# -- SMS (out of scope — completely different system, DLT-based) --
SMS_API_URL=https://japi.instaalerts.zone/httpapi/JsonReceiver
SMS_API_KEY=

# -- Apparel Attribution: main application, no browser/worker host --
# Persistent directory on Render's disk; defaults beside KARIX_DB_PATH.
APPAREL_ATTRIBUTION_STORAGE_DIR=
APPAREL_GOOGLE_SERVICE_ACCOUNT_JSON=
APPAREL_GOOGLE_SERVICE_ACCOUNT_FILE=
APPAREL_GOOGLE_SPREADSHEET_URL=
APPAREL_GOOGLE_WORKSHEET_NAME=Mastersheet
APPAREL_MOENGAGE_QUERY_TIMEOUT_SECONDS=180
# Or configure these in Apparel Settings / Auth Sync. Never reuse Tata credentials.
APPAREL_MOENGAGE_BASE_URL=https://dashboard-03.moengage.com
APPAREL_MOENGAGE_WORKSPACE_ID=
APPAREL_MOENGAGE_BEARER_TOKEN=
APPAREL_MOENGAGE_REFRESH_TOKEN=
APPAREL_MOENGAGE_COOKIE=

# -- Docker/Oracle host runtime --
# These are REQUIRED by docker-compose.yml. Generate each secret independently:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep the chosen values stable across restarts. Never reuse documented examples.
JWT_SECRET=

# -- Optional Karix Google Sign-In (separate from the leave application's client) --
# Google Cloud OAuth Web client ID; leave blank to keep password-only sign-in.
KARIX_GOOGLE_CLIENT_ID=
# Exact browser origins, comma-separated; HTTPS except localhost/127.0.0.1 development.
# Also register these under Authorized JavaScript origins in this Karix Google client.
KARIX_GOOGLE_ALLOWED_ORIGINS=
# Identity domain admission only; never assigns Bajaj/Tata/Apparel access or roles.
KARIX_GOOGLE_ALLOWED_DOMAINS=attributics.com

# -- Tata MoEngage unique-user click counts (portal session, not Karix auth) --
# Keep Tata credentials separate from Bajaj and Apparel.
# Copy authorization, refreshtoken, and Cookie headers from dashboard requests.
# These session credentials expire; replace them manually in env or Tata Settings.
TATA_MOENGAGE_BASE_URL=https://dashboard-03.moengage.com
TATA_MOENGAGE_BEARER_TOKEN=
TATA_MOENGAGE_REFRESH_TOKEN=
TATA_MOENGAGE_COOKIE=
# Portal account ID; authorized workspace IDs are discovered via listApps.
TATA_MOENGAGE_ACCOUNT_ID=6399ced48c5fa78ad1eb39ea
