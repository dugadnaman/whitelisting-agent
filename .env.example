# =============================================================================
# Karix WhatsApp Template Submission — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# =============================================================================


# ---------------------------------------------------------------------------
# SESSION-BASED AUTH (portal API — what currently works)
# ---------------------------------------------------------------------------
# These come from a logged-in Karix portal session (DevTools → Network →
# copy the Authorization/Session/User headers from any API call).
# They expire when the session does — there's no auto-refresh yet.
#
# The portal API base URL is: https://rcsgui.karix.solutions/v1.0/templates
# (note: NO /api prefix, plural "templates")

KARIX_BEARER_TOKEN=
KARIX_SESSION=
KARIX_USER=


# ---------------------------------------------------------------------------
# OFFICIAL STATIC CREDENTIALS (provided by Bajaj)
# ---------------------------------------------------------------------------
# These are the API keys Bajaj officially shared. They may correspond to a
# different API surface than the portal endpoints above.
#
# IMPORTANT: WABA_AUTH_TOKEN returned "Unauthorised User" when used against
# the portal API (https://rcsgui.karix.solutions/v1.0/templates/...).
# It may work against the official WABA_TEMPLATE_ENDPOINT instead — TBD.

# -- WhatsApp (WABA) --
WABA_TEMPLATE_ENDPOINT=https://rcsgui.karix.solutions/api/v1.0/template
WABA_AUTH_TOKEN=
WABA_ID=286109054585247
WABA_API_URL=https://rcmapi.instaalerts.zone/services/rcm/scheduleMessage
WABA_SENDER=

# -- General Karix / RCS (out of scope for now) --
KARIX_AUTH_TOKEN=
KARIX_SENDER_ID=
RCS_API_URL=https://rcmapi.instaalerts.zone/services/rcm/scheduleMessage
RCS_API_KEY=
RCS_SENDER=

# -- SMS (out of scope — completely different system, DLT-based) --
SMS_API_URL=https://japi.instaalerts.zone/httpapi/JsonReceiver
SMS_API_KEY=

# -- Apparel Attribution Worker Gateway --
# Native gateway: private HTTP only on a trusted network; otherwise HTTPS.
# Never expose this token in frontend builds or client requests.
APPAREL_ATTRIBUTION_WORKER_URL=
APPAREL_ATTRIBUTION_TOKEN=

# -- Docker/Oracle host runtime --
# These are REQUIRED by docker-compose.yml. Generate each secret independently:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep the chosen values stable across restarts. Never reuse documented examples.
JWT_SECRET=
APPAREL_BROWSER_USER=
APPAREL_BROWSER_PASSWORD=
# Compose supplies the private worker URL and token to the gateway. Desktop is
# HTTPS on loopback port 3001; use an SSH tunnel or VPN, not public basic auth.
# Only set this to another URL if it is the actual protected admin desktop.
MOENGAGE_BROWSER_LOGIN_URL=https://localhost:3001

# -- Tata MoEngage unique-user click counts (portal session, not Karix auth) --
# Keep Tata credentials separate from Bajaj and Apparel.
# Copy authorization, refreshtoken, and Cookie headers from dashboard requests.
# These session credentials expire; replace them manually in env or Tata Settings.
TATA_MOENGAGE_BASE_URL=https://dashboard-03.moengage.com
TATA_MOENGAGE_BEARER_TOKEN=
TATA_MOENGAGE_REFRESH_TOKEN=
TATA_MOENGAGE_COOKIE=
# Portal account ID; authorized workspace IDs are discovered via listApps.
TATA_MOENGAGE_ACCOUNT_ID=6399ced48c5fa78ad1eb39ea
