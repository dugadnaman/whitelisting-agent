# Worker service: build from repository ROOT, not this module directory.
# Railway: RAILWAY_DOCKERFILE_PATH=agents/apparel-attribution/Dockerfile
# Optional legacy config-file path: /agents/apparel-attribution/railway.toml
# One worker process AND one deployment replica, paired with one browser replica.
# Mount a persistent worker volume at /data; job history is in memory and lost on restart.
PORT=8000
STORAGE_DIR=/data

# REQUIRED sealed secret shared only by Karix gateway and worker (never frontend).
# Generate a random token >=32 characters; empty/weak/placeholder tokens refuse startup.
APPAREL_ATTRIBUTION_TOKEN=
# Set this on the Karix gateway, not the browser. Same Railway project/environment only.
# Example private URL: http://apparel-attribution-worker.railway.internal:8000
# Worker listens on IPv4: use Railway environments with private IPv4 networking.
# Outside private networking, require HTTPS; never expose a plaintext authenticated API.
APPAREL_ATTRIBUTION_WORKER_URL=

# Optional sealed Google service-account key JSON OR a sealed file mount (choose ONE).
# No key goes into the repository, image, public env dump, browser service, or frontend.
# Without a sealed key, an admin can upload the validated key through the native portal;
# it is saved mode 0600 as /data/google-service-account.json. Sealed sources take precedence.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Approved Apparel source: actual spreadsheet URL and exact worksheet name; no sample data.
GOOGLE_SPREADSHEET_URL=
GOOGLE_WORKSHEET_NAME=

# Actual supported report URLs/selectors from the administrator; no fabricated mapping.
# Missing Google credentials, approved source, real report mapping, or authenticated browser
# DISABLES real jobs; it must not produce demo/mock metrics or pretend to be connected.
MOENGAGE_UI_CONFIG_JSON=
# Explicit PRIVATE CDP endpoint for worker; example http://apparel-attribution-browser.railway.internal:9222
# CDP has no authentication: worker/browser must share a trusted private network.
MOENGAGE_REMOTE_CDP_URL=
# Protected HTTPS login URL opens only for admins; this is NOT the CDP endpoint.
MOENGAGE_BROWSER_LOGIN_URL=
MOENGAGE_DASHBOARD_URL=

# Browser service ONLY: build root context using
# RAILWAY_DOCKERFILE_PATH=agents/apparel-attribution/RailwayBrowser/Dockerfile
# Optional legacy config-file path: /agents/apparel-attribution/RailwayBrowser/railway.toml
# Mount /config persistently (browser login/session); exactly one browser replica.
PUID=1000
PGID=1000
TZ=Etc/UTC
# LinuxServer/Selkies exact basic-auth variables. No default credentials.
# Non-default ASCII username >=8 characters; random password >=32 characters.
CUSTOM_USER=
PASSWORD=
# REQUIRED explicit mode: trusted-network OR authenticated-proxy. No insecure default.
# trusted-network: private LAN/VPN only, HTTPS streaming on 3001; basic auth is NOT
# sufficient for an internet-facing stream. Docker example binds 3001 to loopback only.
# authenticated-proxy: a SEPARATE HTTPS reverse proxy must enforce robust authentication
# on every GUI/asset/WebSocket route (OIDC, Authelia, Authentik, oauth2-proxy or mTLS).
# These variables declare the deployed protection, they do not install/verify a proxy.
# Keep the browser's 3000 HTTP backend private to that proxy; do not give the browser
# a direct Railway public domain/TCP proxy, which would bypass proxy authentication.
APPAREL_BROWSER_STREAM_ACCESS=
APPAREL_BROWSER_PUBLIC_URL=
APPAREL_BROWSER_PROXY_AUTH=
# Leave blank to bind CDP on all assigned RFC1918 IPv4 / unique-local IPv6 addresses.
# Optional override must be an actual assigned private address, never 0.0.0.0 or ::.
CDP_BIND_ADDRESS=
# Fixed and guarded: no external DevTools listener or overriding command is accepted.
CHROME_CLI=--remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --disable-dev-shm-usage about:blank
# NEVER publish 9222/9223, mount docker.sock, or run the browser privileged.
# Browser shm size: 1gb on Docker; --disable-dev-shm-usage supports Railway's small /dev/shm.
# Upstream auth/security: https://docs.linuxserver.io/images/docker-chromium/#security
# https://docs.linuxserver.io/selkies/user-guide/security/
